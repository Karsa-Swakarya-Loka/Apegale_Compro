{
  "name": "apegale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "npm run generate",
    "build": "next build",
    "prebuild": "npm run generate",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.ts",
    "typecheck": "tsc --noEmit",
    "generate": "payload generate:types && payload generate:importmap",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "seed": "tsx src/seed/index.ts",
    "seed:report": "tsx scripts/seed-report.ts",
    "setup:admin": "tsx scripts/create-admin.ts",
    "test": "node --experimental-strip-types --test tests/seed.test.ts tests/schema.test.ts tests/services-content.test.ts tests/inquiry.test.ts tests/redirects.test.ts tests/preview.test.ts tests/navigation.test.ts",
    "verify:cms": "tsx scripts/verify-cms.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "content:services": "tsx scripts/migrate-services-content.ts",
    "content:about": "tsx scripts/migrate-about-content.ts",
    "content:client-logos": "tsx scripts/update-client-logos.ts",
    "content:regulations": "tsx scripts/migrate-regulations.ts",
    "check:redirects": "tsx scripts/check-redirects.ts",
    "og:image": "node scripts/build-og-image.mjs",
    "content:copy": "tsx scripts/sync-copy.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
