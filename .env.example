# PostgreSQL is the default. Use a dedicated database for this app.
DATABASE_ADAPTER=postgres
DATABASE_URI=postgresql://apegale:change-me@127.0.0.1:5432/apegale
# Local alternative: DATABASE_ADAPTER=sqlite and DATABASE_URI=file:./.data/apegale.db
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public origin without trailing slash. Read at BUILD time for canonical/hreflang/sitemap/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEDIA_DIR=media
# Real SMTP is only needed for step 8; no test account is created automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Ape Gale Indonesia
# Used only by npm run setup:admin; never seed default credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# npm run seed normally preserves later CMS edits. Set true only for explicit reset from seeds.
SEED_OVERWRITE=false


# Vercel / serverless only: media uploads go to Vercel Blob when this is set (Vercel > Storage > Blob). Leave empty for local dev / VPS.
BLOB_READ_WRITE_TOKEN=
